{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch autoscaler",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go",
            "output": "debug",
            "env": {
                "PROJECT_ID": "my-gcp-project-id",
                "ZONES": "us-east1-c",
                "STATE_DATABASE": "github-runners",
                "CALLBACK_BASE_URL": "https://github-runner-autoscaler-123456789.us-east1.run.app",
                "CALLBACK_SERVICE_ACCOUNT": "runner-callback@my-gcp-project-id.iam.gserviceaccount.com",
                "TASK_QUEUE": "projects/my-gcp-project-id/locations/us-east1/queues/autoscaler-callback-queue",
                "DELETE_TASK_QUEUE": "projects/my-gcp-project-id/locations/us-east1/queues/runner-delete",
                "MAINTENANCE_TASK_QUEUE": "projects/my-gcp-project-id/locations/us-east1/queues/runner-maintenance",
                "INSTANCE_TEMPLATE": "projects/my-gcp-project-id/global/instanceTemplates/ephemeral-github-runner",
                "SECRET_VERSION": "projects/my-gcp-project-id/secrets/github-pat-token/versions/latest",
                "GITHUB_ENTERPRISE": "Enterprise;dmVyeXNlY3JldA==",
                "GITHUB_ORG": "Organization;dmVyeXNlY3JldA==",
                "GITHUB_REPOS": "User/Repo1;dmVyeXNlY3JldA==,User/Repo2;dmVyeXNlY3JldA=="
            }
        }
    ]
}
